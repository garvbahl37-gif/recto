{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "src/insightledger/api/static",
  "framework": null,
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://insightledger-edib.onrender.com/health"
    },
    {
      "source": "/query/stream",
      "destination": "https://insightledger-edib.onrender.com/query/stream"
    },
    {
      "source": "/query",
      "destination": "https://insightledger-edib.onrender.com/query"
    },
    {
      "source": "/ingest",
      "destination": "https://insightledger-edib.onrender.com/ingest"
    },
    {
      "source": "/tickers",
      "destination": "https://insightledger-edib.onrender.com/tickers"
    },
    {
      "source": "/company",
      "destination": "https://insightledger-edib.onrender.com/company"
    },
    {
      "source": "/documents",
      "destination": "https://insightledger-edib.onrender.com/documents"
    },
    {
      "source": "/documents/:id/pages/:n",
      "destination": "https://insightledger-edib.onrender.com/documents/:id/pages/:n"
    },
    {
      "source": "/documents/:id",
      "destination": "https://insightledger-edib.onrender.com/documents/:id"
    },
    {
      "source": "/trace/:id",
      "destination": "https://insightledger-edib.onrender.com/trace/:id"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
